{
  "manifest_version": 3,
  "name": "Dead Center",
  "version": "1.0.0",
  "description": "Read the page you're on, or what you've selected, in Dead Center.",
  "homepage_url": "https://github.com/Mason363/DeadCenter",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Read in Dead Center",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["activeTab", "scripting", "contextMenus", "nativeMessaging"],
  "commands": {
    "read-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "MacCtrl+Shift+Period"
      },
      "description": "Read the page, or the selection, in Dead Center"
    }
  }
}
